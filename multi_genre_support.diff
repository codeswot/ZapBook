--- a/lib/core/constants/book_genres.dart
+++ b/lib/core/constants/book_genres.dart
@@ -15,3 +15,30 @@ const List<String> bookGenres = [
   'Philosophy',
   'Art',
 ];
+
+/// A book's genre is persisted (in `.zbf` manifests, Nostr group metadata,
+/// and the local circle store) as a single, optionally comma-separated
+/// [String]. These helpers convert between that wire format and a
+/// [List<String>] that's convenient for multi-select UI, while staying
+/// backward compatible with older manifests that only ever stored one
+/// genre.
+///
+/// e.g. "Science Fiction, Philosophy" <-> ['Science Fiction', 'Philosophy']
+List<String> genresFromField(String? genre) {
+  if (genre == null) return const [];
+  return genre
+      .split(',')
+      .map((g) => g.trim())
+      .where((g) => g.isNotEmpty)
+      .toSet()
+      .toList();
+}
+
+/// Joins a list of genres back into the comma-separated wire format.
+/// Returns `null` when there are no genres, so callers can keep treating
+/// "no genre" the same way they did before this field supported lists.
+String? genresToField(List<String> genres) {
+  final cleaned = genres.map((g) => g.trim()).where((g) => g.isNotEmpty);
+  if (cleaned.isEmpty) return null;
+  return cleaned.join(', ');
+}
